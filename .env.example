# AROMA — Environment Variables Template
# IBM Bob Hackathon 2026
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. NEVER commit .env to version control
# 4. NEVER share your WATSONX_API_KEY publicly
#
# Where to get IBM watsonx.ai values:
# 1. Log in to https://dataplatform.cloud.ibm.com (watsonx.ai)
# 2. Scroll to "Developer access" section
# 3. Select "watsonx Hackathon Sandbox" from Project dropdown → copy Project ID
# 4. Click "Create API key" → copy the API key
# 5. Ensure region is set to "Dallas" (us-south)
#
# Reference: IBM Bob Hackathon 2026 Guide — "Programmatic access (API/SDK)" section

# =============================================================================
# Database
# =============================================================================
# Option A: SQLite (local development)
DATABASE_URL=file:./dev.db

# Option B: Supabase PostgreSQL (uncomment and fill)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# =============================================================================
# IBM watsonx.ai — REQUIRED for all AI analysis modules
# =============================================================================

# IBM Cloud API key (from IAM → API Keys → Create, or watsonx.ai Developer Access)
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai Project ID (from Developer Access → Project dropdown)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — Dallas (us-south) per hackathon guide
WATSONX_ENDPOINT=https://us-south.ml.cloud.ibm.com

# IBM Granite foundation model
# Recommended: ibm/granite-4-h-small (current, fast, cost-efficient)
# Legacy: ibm/granite-3-8b-instruct (withdrawn, still works)
# DO NOT USE: llama-3-405b-instruct, mistral-medium-2505, mistral-small-3-1-24b-instruct-2503
WATSONX_MODEL_ID=ibm/granite-4-h-small
